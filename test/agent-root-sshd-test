#!/usr/bin/env bash
# Real OpenSSH end to end: an unprivileged sshd on a loopback port proves the
# key restrictions and the sshd drop-in behave as documented. Opt-in with
# AGENT_ROOT_TEST_REAL_SSHD=1 because shared CI has no OpenSSH server.

set -uo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

# shellcheck source=lib/test.sh
. "$ROOT/test/lib/test.sh"

printf '=== agent-root with a real sshd ===\n'

if [[ "${AGENT_ROOT_TEST_REAL_SSHD:-0}" != 1 ]]; then
  printf '  SKIP: set AGENT_ROOT_TEST_REAL_SSHD=1 to run against a real sshd\n'
  _test_summary
fi

sshd_bin=$(command -v sshd 2>/dev/null || true)
[[ -n "$sshd_bin" ]] || sshd_bin=/usr/sbin/sshd
if [[ ! -x "$sshd_bin" ]]; then
  _fail "real sshd: sshd is not installed"
  _test_summary
fi

tmp=$(_tmpdir)
tmp=$(cd -P -- "$tmp" && pwd -P)
user=$(id -un)
sshd_pid=

_stop_sshd() {
  [[ -z "$sshd_pid" ]] || kill "$sshd_pid" 2>/dev/null
  [[ -z "$sshd_pid" ]] || wait "$sshd_pid" 2>/dev/null
  sshd_pid=
}
trap '_stop_sshd; _cleanup_test_root' EXIT

ssh-keygen -q -t ed25519 -N '' -f "$tmp/host_key"
mkdir -p "$tmp/sshd_config.d" "$tmp/fakebin" "$tmp/config/hosts.d"

# Mirror a distribution layout: drop-ins are included first, and global
# settings follow. `Match all` in the drop-in must keep those globals global.
write_config() {
  cat >"$1" <<EOF
Include $tmp/sshd_config.d/*.conf
ListenAddress 127.0.0.1
Port $2
HostKey $tmp/host_key
PidFile $tmp/sshd.pid
AuthorizedKeysFile $tmp/authorized_keys
StrictModes no
UsePAM no
PasswordAuthentication no
KbdInteractiveAuthentication no
AllowUsers $user
MaxSessions 7
EOF
}

sed 's|@FROM@|127.0.0.1|' "$ROOT/lib/agent-root/sshd-match.conf.in" \
  >"$tmp/sshd_config.d/50-agent-root.conf"
write_config "$tmp/sshd_config" 2222
check_status=0
check_output=$("$sshd_bin" -t -f "$tmp/sshd_config" 2>&1) || check_status=$?
_assert_exit "drop-in: sshd accepts the rendered template" 0 "$check_status"
_assert_eq "drop-in: sshd reports no configuration errors" "" "$check_output"

# OpenSSH 10 prints keywords in configuration case; older releases lowercase.
settings() {
  "$sshd_bin" -T -f "$1" -C "$2" 2>&1 | awk '{ $1 = tolower($1); print }'
}

root_local=$(settings "$tmp/sshd_config" user=root,host=localhost,addr=127.0.0.1)
# Every setting inside the Match block must come back verbatim from sshd -T;
# enroll relies on that to verify the drop-in took effect.
while IFS= read -r setting; do
  _assert_contains "drop-in: root from an enrolled address gets '$setting'" \
    "$setting" "$root_local"
done < <(awk '/^Match User/{ m = 1; next } /^Match all/{ m = 0 }
  m && $1 !~ /^#/ && NF { $1 = tolower($1); print }' \
  "$tmp/sshd_config.d/50-agent-root.conf")
root_remote=$(settings "$tmp/sshd_config" user=root,host=probe.invalid,addr=192.0.2.1)
_assert_not_contains "drop-in: root from other addresses keeps the global policy" \
  "permitrootlogin forced-commands-only" "$root_remote"

# Compare a non-matching connection with and without the drop-in: identical
# output proves the Match block closed before the main file's globals.
mkdir -p "$tmp/empty.d"
sed "s|$tmp/sshd_config.d/|$tmp/empty.d/|" "$tmp/sshd_config" >"$tmp/sshd_config.bare"
other_with=$(settings "$tmp/sshd_config" "user=$user,host=probe.invalid,addr=192.0.2.1")
other_without=$(settings "$tmp/sshd_config.bare" "user=$user,host=probe.invalid,addr=192.0.2.1")
_assert_eq "drop-in: other connections see unchanged settings" \
  "$other_without" "$other_with"
_assert_contains "drop-in: globals after the include stay global" \
  "maxsessions 7" "$other_with"

# The forced command runs with sshd's minimal PATH; the shim puts the fake
# logger first so the audit trail lands in a file the test can read.
cat >"$tmp/fakebin/logger" <<EOF
#!/usr/bin/env bash
while [[ \$# -gt 0 && \$1 != -- ]]; do shift; done
shift
printf '%s\n' "\$*" >>"$tmp/audit.log"
EOF
chmod +x "$tmp/fakebin/logger"
cat >"$tmp/exec-shim" <<EOF
#!/usr/bin/env bash
PATH="$tmp/fakebin:\$PATH" exec "$ROOT/lib/agent-root/agent-root-exec"
EOF
chmod +x "$tmp/exec-shim"

# An unprivileged sshd can only log in as its own user, so the live checks
# use a second copy of the drop-in matched on that user, with the on-host
# paths moved into the test tree. Root's copy above stays as installed.
agent_keys="$tmp/agent-root/authorized_keys"
mkdir -p "$tmp/agent-root"
sed -e 's|@FROM@|127.0.0.1|' -e "s|^Match User root |Match User $user |" \
  -e "s|AllowUsers root|AllowUsers $user|" \
  -e "s|/etc/ssh/agent-root/authorized_keys|$agent_keys|" \
  -e "s|/usr/local/sbin/agent-root-exec|$tmp/exec-shim|" \
  "$ROOT/lib/agent-root/sshd-match.conf.in" >"$tmp/sshd_config.d/40-live.conf"

export AGENT_ROOT_CONFIG_DIR="$tmp/config" AGENT_ROOT_SSH_USER="$user"
agent_root="$ROOT/bin/agent-root"

start_sshd() {
  local port deadline

  for _ in 1 2 3 4 5; do
    port=$((20000 + RANDOM % 20000))
    write_config "$tmp/sshd_config" "$port"
    : >"$tmp/sshd.log"
    "$sshd_bin" -D -e -f "$tmp/sshd_config" 2>"$tmp/sshd.log" &
    sshd_pid=$!
    deadline=$((SECONDS + ${AGENT_ROOT_TEST_WAIT_SECONDS:-20}))
    while ((SECONDS < deadline)); do
      if grep -q 'Server listening' "$tmp/sshd.log"; then
        printf 'host=127.0.0.1\nport=%s\nfrom=127.0.0.1\n' "$port" \
          >"$tmp/config/hosts.d/test.conf"
        return 0
      fi
      kill -0 "$sshd_pid" 2>/dev/null || break
      sleep 0.1
    done
    _stop_sshd
  done
  printf 'sshd did not start; last log:\n%s\n' "$(<"$tmp/sshd.log")" >&2
  return 1
}

if ! start_sshd; then
  _fail "real sshd: server starts"
  _test_summary
fi

keygen_output=$("$agent_root" keygen test 2>&1)
_assert_contains "keygen: creates the host key" "created" "$keygen_output"
pubkey=$(<"$tmp/config/keys/test.pub")

authorize() {
  printf 'from="%s",restrict,command="%s" %s\n' "$1" "$tmp/exec-shim" "$pubkey" \
    >"$agent_keys"
}
authorize 127.0.0.1

run_status=0
run_output=$("$agent_root" run test -- id -un 2>&1) || run_status=$?
_assert_exit "run: an enrolled source address is accepted" 0 "$run_status"
_assert_eq "run: the command runs as the key's account" "$user" "$run_output"

# The second word must reach the target unexpanded.
# shellcheck disable=SC2016
words_output=$("$agent_root" run test -- printf '<%s>' 'a b' '$HOME;x' "it's" 2>&1)
_assert_eq "run: arguments arrive as the same words" \
  "<a b><\$HOME;x><it's>" "$words_output"

script_output=$(printf 'echo one\necho two\n' | "$agent_root" run test 2>&1)
_assert_eq "run: a script on standard input runs" $'one\ntwo' "$script_output"

exit_status=0
"$agent_root" run test -- bash -c 'exit 7' >/dev/null 2>&1 || exit_status=$?
_assert_exit "run: the remote exit status comes back" 7 "$exit_status"

fingerprint=$(ssh-keygen -lf "$tmp/config/keys/test.pub" | cut -d' ' -f2)
audit=$(<"$tmp/audit.log")
_assert_contains "audit: commands are logged with their source and key" \
  "run from=127.0.0.1 key=$fingerprint: id -un" "$audit"
_assert_contains "audit: scripts are logged with their content" \
  'script| echo one\necho two' "$audit"
_assert_contains "audit: exit statuses are logged" "exit status=7" "$audit"

# ForceCommand: sshd runs the wrapper even for an entry without command=.
# (For root, forced-commands-only refuses such an entry outright; this
# unprivileged sshd cannot log in as root, so it shows the second layer.)
printf 'from="127.0.0.1",restrict %s\n' "$pubkey" >"$agent_keys"
: >"$tmp/audit.log"
bare_output=$("$agent_root" run test -- echo bare 2>&1)
_assert_eq "forcecommand: an entry without command= runs the wrapper" "bare" "$bare_output"
_assert_contains "forcecommand: and the wrapper logs it" \
  "run from=127.0.0.1 key=$fingerprint: echo bare" "$(<"$tmp/audit.log")"

# Only agent-root's key file counts: the same key in the account's ordinary
# authorized_keys is not accepted from an enrolled address.
: >"$agent_keys"
printf '%s\n' "$pubkey" >"$tmp/authorized_keys"
other_file_status=0
"$agent_root" run test -- true >/dev/null 2>&1 || other_file_status=$?
_assert_exit "keys file: keys outside agent-root's file are refused" 255 \
  "$other_file_status"
: >"$tmp/authorized_keys"

# A pinned host key that does not match is refused, not replaced.
cp "$tmp/config/known_hosts" "$tmp/known_hosts.good"
_assert_contains "known_hosts: entries use the host's alias" \
  "agent-root-test " "$(<"$tmp/known_hosts.good")"
ssh-keygen -q -t ed25519 -N '' -f "$tmp/other_host_key"
printf 'agent-root-test %s\n' "$(cut -d' ' -f1,2 "$tmp/other_host_key.pub")" \
  >"$tmp/config/known_hosts"
authorize 127.0.0.1
pinned_status=0
"$agent_root" run test -- true >/dev/null 2>&1 || pinned_status=$?
_assert_exit "known_hosts: a mismatched pinned key is refused" 255 "$pinned_status"
cp "$tmp/known_hosts.good" "$tmp/config/known_hosts"

# A key restricted to another source address must be refused outright.
authorize 127.0.0.2
refused_status=0
"$agent_root" run test -- id -un >/dev/null 2>&1 || refused_status=$?
_assert_exit "from: a source outside the key's from list is refused" 255 \
  "$refused_status"

_stop_sshd
_test_summary
